<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <EditText
        android:id="@+id/et_way_to_folder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:ems="12"
        android:hint="@string/ht_full_way_to_folder"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/bt_file_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bt_file_search"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/et_way_to_folder"
        app:layout_constraintTop_toTopOf="@+id/et_way_to_folder" />


    <Button
        android:id="@+id/bt_to_create_folder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/to_create_folder"
        android:textSize="16sp"
        tools:visibility="invisible"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_way_to_folder"/>

    <EditText
        android:id="@+id/et_new_folder_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="64dp"
        android:ems="8"
        android:hint="@string/ht_folder_name"
        android:visibility="gone"
        tools:visibility="visible"
        android:inputType="text"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_way_to_folder"/>

    <Button
        android:id="@+id/bt_create_folder_confirm"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:foreground="@drawable/baseline_done_24"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/et_new_folder_name"
        app:layout_constraintTop_toTopOf="@+id/et_new_folder_name" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_files_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bt_to_create_folder"
        android:layout_marginTop="32dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>