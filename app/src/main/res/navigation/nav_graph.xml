<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.registration.ui.login.LoginFragment"
        android:label="LoginFragment">
        <action
            android:id="@+id/action_loginFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
        <action
            android:id="@+id/action_loginFragment_to_userMainPageFragment"
            app:destination="@id/userMainPageFragment" />
    </fragment>
    <fragment
        android:id="@+id/registrationFragment"
        android:name="com.example.registration.ui.registration.RegistrationFragment"
        android:label="RegistrationFragment">
        <action
            android:id="@+id/action_registrationFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/userProfilePageFragment"
        android:name="com.example.registration.ui.user.profile.UserProfilePageFragment"
        android:label="CustomerProfilePageFragment">
        <action
            android:id="@+id/action_userProfilePageFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/userMainPageFragment"
        android:name="com.example.registration.ui.user.mainpage.UserMainPageFragment"
        android:label="UserMainPageFragment" >
        <action
            android:id="@+id/action_userMainPageFragment_to_userProfilePageFragment"
            app:destination="@id/userProfilePageFragment" />
        <action
            android:id="@+id/action_userMainPageFragment_to_fileManageFragment"
            app:destination="@id/fileManageFragment" />
    </fragment>
    <fragment
        android:id="@+id/fileManageFragment"
        android:name="com.example.registration.ui.fileManage.FileManageFragment"
        android:label="FileManageFragment" >
        <action
            android:id="@+id/action_fileManageFragment_to_serverFilesFragment"
            app:destination="@id/serverFilesFragment" />
        <action
            android:id="@+id/action_fileManageFragment_to_uploadToServerFragment"
            app:destination="@id/uploadToServerFragment" />
    </fragment>
    <fragment
        android:id="@+id/serverFilesFragment"
        android:name="com.example.registration.ui.serverFiles.ServerFilesFragment"
        android:label="ServerFilesFragment" />
    <fragment
        android:id="@+id/uploadToServerFragment"
        android:name="com.example.registration.ui.uploadToServer.UploadToServerFragment"
        android:label="UploadToServerFragment" />
</navigation>